---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ExternalLink from "../components/external-link.astro";
---

<InfoLayout title="Contact" description="联系 soundead。">
  <section class="p-4 sm:pt-8 sm:px-12 pb-28 min-h-dvh flex flex-col justify-between gap-20 max-w-4xl">
    <div>
      <H1>Contact</H1>
      <p class="mt-5 sm:mt-10 text-xl sm:text-2xl text-zinc-400 text-balance leading-relaxed">
        声音设计、交互音频或合作相关事项，可以通过邮件联系。
      </p>

      <div class="mt-10 flex flex-col gap-4">
        <a href="mailto:amzsowhat@gmail.com" class="w-fit text-2xl sm:text-4xl text-zinc-100 underline underline-offset-8 decoration-zinc-600 hover:decoration-zinc-100 transition-colors">
          amzsowhat@gmail.com
        </a>
        <ExternalLink href="https://github.com/amzsowhat">GitHub</ExternalLink>
      </div>
    </div>

    <p class="text-sm text-zinc-600">soundead</p>
  </section>
</InfoLayout>
