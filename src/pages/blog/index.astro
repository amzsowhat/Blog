---
import { getCollection } from "astro:content";
import H1 from "../../components/h1.astro";
import { formatDate } from "../../lib/utils";
import InfoLayout from "../../layouts/InfoLayout.astro";

const articles = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<InfoLayout title="Articles" description="Kakuon ??????????wise ?????????????>
  <section class="p-4 sm:pt-8 sm:px-12 pb-28 min-h-dvh max-w-4xl">
    <H1>Articles</H1>
    <p class="mt-5 text-lg sm:text-xl text-zinc-400 max-w-2xl leading-relaxed">
      ?????????????????????????????????????????????????    </p>

    <ul class="mt-12 divide-y divide-white/10">
      {articles.map((article) => (
        <li class="py-7 first:pt-0">
          <a class="block group" href={`/blog/${article.id}`}>
            <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500">
              <span>{article.data.category}</span>
              <span aria-hidden="true">?</span>
              <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
            </div>
            <h2 class="mt-2 text-2xl sm:text-3xl text-zinc-100 group-hover:text-white tracking-tight">
              {article.data.title}
            </h2>
            <p class="mt-2 text-zinc-400 leading-relaxed max-w-2xl">{article.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</InfoLayout>