---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import TimeWarpBackground from "../components/time-warp-background.tsx";
import { sounds } from "../data/sounds";

const collections = new Map<string, typeof sounds>();

for (const item of sounds) {
  const entries = collections.get(item.collection) ?? [];
  entries.push(item);
  collections.set(item.collection, entries);
}

const collectionGroups = [...collections].map(([collection, entries]) => {
  const sections = new Map<string, typeof entries>();
  for (const item of entries) {
    const sectionEntries = sections.get(item.section) ?? [];
    sectionEntries.push(item);
    sections.set(item.section, sectionEntries);
  }

  return {
    collection,
    count: entries.length,
    sections: [...sections],
  };
});
---

<InfoLayout title="Sounds" description="音频与视频作品。">
  <section class="p-4 sm:pt-8 sm:px-12 pb-28 min-h-dvh max-w-5xl">
    <H1>Sounds</H1>

    {sounds.length > 0 ? (
      <div class="mt-12 space-y-8">
        {collectionGroups.map(({ collection, count, sections }) => (
            <details class="sound-collection group rounded-2xl border border-white/10 bg-white/[0.025]">
              <summary class="relative isolate flex min-h-32 cursor-pointer list-none items-end justify-between gap-5 overflow-hidden px-5 py-5 sm:min-h-40 sm:px-7 sm:py-6">
                {collection === "Hunter Roulette OST" && (
                  <img class="absolute inset-0 -z-20 h-full w-full object-cover object-center" src="/Media/Sounds/HunterRouletteOST/Cover.jpg" alt="" />
                )}
                <span class="absolute inset-0 -z-10 bg-gradient-to-t from-zinc-950 via-zinc-950/55 to-zinc-950/15" aria-hidden="true"></span>
                <h2 id={`collection-${collection}`} class="text-2xl sm:text-3xl text-white tracking-tight drop-shadow-lg">{collection}</h2>
                <span class="collection-arrow text-lg text-white drop-shadow-lg" aria-hidden="true">⌄</span>
              </summary>

              <div class="border-t border-white/10 px-5 py-7 sm:px-7 sm:py-8">
                <div class="space-y-10">
                {[...sections].map(([section, sectionEntries]) => (
                  <section aria-labelledby={`section-${collection}-${section}`}>
                    <h3 id={`section-${collection}-${section}`} class="text-sm uppercase tracking-[0.18em] text-zinc-500">{section}</h3>
                    <ul class="mt-4 grid gap-4">
                      {sectionEntries.map((item) => (
                        <li class="sound-item relative isolate overflow-hidden rounded-xl border border-white/10 bg-zinc-950/55 p-5 transition-colors duration-500">
                          <div class="relative flex items-center gap-4">
                            <h4 class="text-xl text-zinc-100">{item.title}</h4>
                            {item.duration && <span class="ml-auto text-xs text-zinc-500 whitespace-nowrap">{item.duration}</span>}
                            {item.type === "audio" && (
                              <button class="track-play ml-auto rounded-full border border-white/20 px-4 py-2 text-sm text-zinc-100 transition-colors hover:bg-white/10" type="button" data-source={item.source} data-title={item.title}>
                                播放
                              </button>
                            )}
                          </div>
                          {item.description && <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{item.description}</p>}
                          {item.type === "video" ? (
                            <video class="relative mt-5 w-full rounded-lg bg-black" controls preload="metadata" poster={item.poster} src={item.source}>
                              Your browser does not support video playback.
                            </video>
                          ) : (
                            <div class="player-slot"></div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
                </div>
              </div>
            </details>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-zinc-500">尚无公开条目。</p>
    )}
  </section>
</InfoLayout>

<div id="sound-wave-parking" aria-hidden="true">
  <div id="shared-item-wave" class="item-wave">
    <TimeWarpBackground variant="hero" client:load />
  </div>
  <audio id="shared-audio-player" class="relative mt-5 w-full" controls preload="none">
    Your browser does not support audio playback.
  </audio>
</div>

<style>
  .sound-collection > summary::-webkit-details-marker { display: none; }
  .sound-collection[open] .collection-arrow { transform: rotate(180deg); }
  .collection-arrow { display: inline-block; transition: transform 220ms ease; }
  .sound-item.is-playing { border-color: rgb(255 255 255 / 0.45); background: transparent; }
  #sound-wave-parking { position: fixed; left: -9999px; top: 0; width: 1px; height: 1px; overflow: hidden; }
  .item-wave { position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity 500ms ease; }
  .sound-item.is-playing > .item-wave { opacity: 1; }
</style>

<script>
  const sharedPlayer = document.querySelector<HTMLAudioElement>("#shared-audio-player");
  const sharedWave = document.querySelector<HTMLElement>("#shared-item-wave");
  const playButtons = document.querySelectorAll<HTMLButtonElement>(".track-play");
  let activeItem: Element | null = null;
  let activeButton: HTMLButtonElement | null = null;

  for (const button of playButtons) {
    button.addEventListener("click", async () => {
      if (!sharedPlayer) return;
      const item = button.closest(".sound-item");
      const slot = item?.querySelector(".player-slot");
      const source = button.dataset.source;
      if (!item || !slot || !source) return;

      if (activeButton) activeButton.hidden = false;
      activeItem?.classList.remove("is-playing");
      sharedPlayer.pause();

      activeItem = item;
      activeButton = button;
      button.hidden = true;
      if (sharedWave) item.prepend(sharedWave);
      slot.append(sharedPlayer);

      if (sharedPlayer.getAttribute("src") !== source) {
        sharedPlayer.src = source;
        sharedPlayer.load();
      }

      try {
        await sharedPlayer.play();
      } catch {
        button.hidden = false;
      }
    });
  }

  sharedPlayer?.addEventListener("play", () => activeItem?.classList.add("is-playing"));
  sharedPlayer?.addEventListener("pause", () => activeItem?.classList.remove("is-playing"));
  sharedPlayer?.addEventListener("ended", () => activeItem?.classList.remove("is-playing"));
</script>
