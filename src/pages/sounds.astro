---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import { sounds } from "../data/sounds";

const collections = new Map<string, typeof sounds>();

for (const item of sounds) {
  const entries = collections.get(item.collection) ?? [];
  entries.push(item);
  collections.set(item.collection, entries);
}

const collectionGroups = [...collections].map(([collection, entries]) => {
  const sections = new Map<string, typeof entries>();
  for (const item of entries) {
    const sectionEntries = sections.get(item.section) ?? [];
    sectionEntries.push(item);
    sections.set(item.section, sectionEntries);
  }

  return {
    collection,
    count: entries.length,
    sections: [...sections],
  };
});
---

<InfoLayout title="Sounds" description="音频与视频作品。">
  <section class="p-4 sm:pt-8 sm:px-12 pb-28 min-h-dvh max-w-5xl">
    <H1>Sounds</H1>

    {sounds.length > 0 ? (
      <div class="mt-12 space-y-8">
        {collectionGroups.map(({ collection, count, sections }) => (
            <details class="sound-collection group rounded-2xl border border-white/10 bg-white/[0.025]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-5 py-5 sm:px-7 sm:py-6">
                <h2 id={`collection-${collection}`} class="text-2xl sm:text-3xl text-zinc-100 tracking-tight">{collection}</h2>
                <span class="flex items-center gap-4 text-xs text-zinc-500">
                  <span>{count} tracks</span>
                  <span class="collection-arrow text-lg text-zinc-300" aria-hidden="true">⌄</span>
                </span>
              </summary>

              <div class="space-y-10 border-t border-white/10 px-5 py-7 sm:px-7 sm:py-8">
                {[...sections].map(([section, sectionEntries]) => (
                  <section aria-labelledby={`section-${collection}-${section}`}>
                    <h3 id={`section-${collection}-${section}`} class="text-sm uppercase tracking-[0.18em] text-zinc-500">{section}</h3>
                    <ul class="mt-4 grid gap-4">
                      {sectionEntries.map((item) => (
                        <li class="sound-item relative isolate overflow-hidden rounded-xl border border-white/10 bg-black/10 p-5 transition-colors duration-500">
                          <div class="sound-wave absolute inset-0 -z-10 opacity-0 transition-opacity duration-700" aria-hidden="true"></div>
                          <div class="flex items-start gap-4">
                            <h4 class="text-xl text-zinc-100">{item.title}</h4>
                            {item.duration && <span class="ml-auto text-xs text-zinc-500 whitespace-nowrap">{item.duration}</span>}
                          </div>
                          {item.description && <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{item.description}</p>}
                          {item.type === "video" ? (
                            <video class="mt-5 w-full rounded-lg bg-black" controls preload="metadata" poster={item.poster} src={item.source}>
                              Your browser does not support video playback.
                            </video>
                          ) : (
                            <audio class="mt-5 w-full" controls preload="none" src={item.source}>
                              Your browser does not support audio playback.
                            </audio>
                          )}
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </details>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-zinc-500">尚无公开条目。</p>
    )}
  </section>
</InfoLayout>

<style>
  .sound-collection > summary::-webkit-details-marker { display: none; }
  .sound-collection[open] .collection-arrow { transform: rotate(180deg); }
  .collection-arrow { display: inline-block; transition: transform 220ms ease; }
  .sound-item.is-playing { border-color: rgb(255 255 255 / 0.22); }
  .sound-item.is-playing .sound-wave { opacity: 0.55; }
  .sound-wave {
    background:
      radial-gradient(ellipse at 18% 120%, transparent 0 27%, rgb(143 200 238 / 0.32) 28%, transparent 30% 39%, rgb(220 235 217 / 0.22) 40%, transparent 42%),
      radial-gradient(ellipse at 78% -35%, transparent 0 31%, rgb(234 217 167 / 0.2) 32%, transparent 34% 45%, rgb(255 255 255 / 0.12) 46%, transparent 48%),
      linear-gradient(110deg, rgb(21 26 46 / 0.7), rgb(68 66 95 / 0.42));
    background-size: 115% 115%, 120% 120%, 100% 100%;
    animation: sound-wave-drift 7s ease-in-out infinite alternate;
  }
  @keyframes sound-wave-drift {
    from { background-position: 0% 0%, 100% 0%, 0 0; transform: scale(1); }
    to { background-position: 8% 5%, 90% 8%, 0 0; transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-wave { animation: none; }
  }
</style>

<script>
  const audioPlayers = document.querySelectorAll<HTMLAudioElement>(".sound-item audio");
  for (const player of audioPlayers) {
    const item = player.closest(".sound-item");
    player.addEventListener("play", () => {
      for (const other of audioPlayers) {
        if (other !== player && !other.paused) other.pause();
      }
      document.querySelectorAll(".sound-item.is-playing").forEach((entry) => entry.classList.remove("is-playing"));
      item?.classList.add("is-playing");
    });
    player.addEventListener("pause", () => item?.classList.remove("is-playing"));
    player.addEventListener("ended", () => item?.classList.remove("is-playing"));
  }
</script>
