---
import clsx from "clsx/lite";

type Props =  {
    href: string
    openNewTab?: boolean
    ariaLabel?: string
    active?: boolean
    className?: string
}

const { href, openNewTab = true, ariaLabel, active, className } = Astro.props

const pathname = Astro.url.pathname;
const isActive = active ?? pathname === href;
---

<a href={href} target={openNewTab ? "_blank" : "_self"}
    rel={openNewTab ? "noopener noreferrer" : undefined}
    aria-label={ariaLabel}
    aria-current={isActive ? "page" : undefined}
    class={clsx(
        "w-fit group flex items-center gap-1 text-base hover:text-zinc-100 focus-visible:outline-2 outline-offset-4 outline-zinc-100/40 rounded-sm cursor-pointer",
        isActive ? "text-zinc-100" : "text-zinc-500",
        className,
    )}>
    <slot />
   {openNewTab &&  
        <svg xmlns="http://www.w3.org/2000/svg" class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <title>Arrow Icon</title>
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 12h2.5M20 12l-6-6m6 6l-6 6m6-6H9.5"/>
        </svg>
    }
</a>
