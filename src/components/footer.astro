---
import ExternalLink from "./external-link.astro";

const pathname = Astro.url.pathname;
---

<footer class="fixed bottom-0 left-0 right-0 sm:left-auto sm:right-auto z-40 py-4 px-3 sm:px-12 w-auto sm:w-full bg-zinc-900/95 backdrop-blur-sm">
  <nav aria-label="Footer" class="flex items-center justify-between sm:justify-start gap-2 sm:gap-8">
    <ExternalLink href="/" openNewTab={false} className="text-sm sm:text-base">Home</ExternalLink>
    <ExternalLink href="/sounds" openNewTab={false} className="text-sm sm:text-base">Sounds</ExternalLink>
    <ExternalLink href="/blog" openNewTab={false} active={pathname === "/blog" || pathname.startsWith("/blog/")} className="text-sm sm:text-base">Articles</ExternalLink>
    <ExternalLink href="/about" openNewTab={false} className="text-sm sm:text-base">About</ExternalLink>
    <ExternalLink href="/contact" openNewTab={false} className="text-sm sm:text-base">Contact</ExternalLink>
  </nav>
</footer>
