---
import clsx from "clsx";
import ExternalLink from "./external-link.astro";

const pathname = Astro.url.pathname;
---

<footer class="fixed bottom-0 z-40 py-4 px-4 sm:px-12 w-full flex items-center gap-4 sm:gap-8 bg-zinc-900/95 backdrop-blur-sm">
  <div class="flex items-center gap-1">
    <ExternalLink href="/" openNewTab={false}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class="w-6 h-6 text-zinc-500 group-hover:text-zinc-100">
        <title>Home</title>
        <path fill="currentColor" fill-rule="evenodd" d="M2.335 7.875c-.54 1.127-.35 2.446.03 5.083l.278 1.937c.487 3.388.731 5.081 1.906 6.093S7.447 22 10.894 22h2.212c3.447 0 5.17 0 6.345-1.012s1.419-2.705 1.906-6.093l.279-1.937c.38-2.637.57-3.956.029-5.083s-1.691-1.813-3.992-3.183l-1.385-.825C14.2 2.622 13.154 2 12 2s-2.199.622-4.288 1.867l-1.385.825c-2.3 1.37-3.451 2.056-3.992 3.183M8.25 18a.75.75 0 0 1 .75-.75h6a.75.75 0 0 1 0 1.5H9a.75.75 0 0 1-.75-.75" clip-rule="evenodd"/>
      </svg>
    </ExternalLink>

    <span class="text-zinc-600" aria-hidden="true">/</span>

    <ExternalLink href="/sounds" openNewTab={false}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" class={clsx("w-6 h-6", pathname === "/sounds" ? "text-zinc-100" : "text-zinc-500 group-hover:text-zinc-100")}>
        <title>Sounds</title>
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7" d="M3 12h2l1.7-5.5L10 18l3-13l2.5 7H21"/>
      </svg>
    </ExternalLink>
  </div>

  <ExternalLink href="/blog" openNewTab={false}>Articles</ExternalLink>
  <ExternalLink href="/about" openNewTab={false}>About</ExternalLink>
  <ExternalLink href="/contact" openNewTab={false}>Contact</ExternalLink>
</footer>
