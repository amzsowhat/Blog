---
import RootLayout from "./RootLayout.astro";
import Footer from "../components/footer.astro";
import TimeWarpBackground from "../components/time-warp-background";

const { title, description } = Astro.props;
---

<RootLayout title={title} description={description}>
  <div class="relative isolate flex gap-4 w-full max-w-screen-xl min-h-dvh">
    <aside aria-hidden="true" class="relative z-0 w-4 md:min-w-2xs xl:min-w-sm sm:min-h-screen sm:ml-4 sm:pb-4">
      <div class="fixed z-0 w-4 md:w-2xs xl:w-sm h-full sm:bottom-4 sm:rounded-b-full overflow-hidden">
        <TimeWarpBackground variant="panel" client:idle />
      </div>
    </aside>

    <div class="relative z-10 flex-1 min-w-0">
      <main><slot /></main>
      <Footer />
    </div>
  </div>
</RootLayout>
